{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "prepcode",
  "version": "0.0.9",
  "identifier": "in.prepwisely.code",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "prepcode",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-only",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQ0NDQjQxRkFENDZFNkQKUldSdGJ0VDZRY3ZNYlJNQkVsUFhvT2hmSkkzYjZPdXZicThEb09PTks2L09WQXBIRFlPZEFyMHEK",
      "endpoints": [
        "https://github.com/dharanish01g/prepcode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
